# ==============================================================================
# SentinelOps AI - Environment Configuration
# ==============================================================================

# LLM Provider Configuration (Optional in Demo Mode)
# Leave empty to run in deterministic Demo Mode without an external LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Execution Mode: "demo" (deterministic, no API key needed) or "llm" (Groq API)
EXECUTION_MODE=demo

# Service Ports
PORT=4000
SIMULATOR_PORT=5001
WEB_PORT=3000

# Service URLs
SIMULATOR_URL=http://localhost:5001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SIMULATOR_URL=http://localhost:5001

# Storage Paths
DATABASE_PATH=./data/sentinelops.db
SIMULATOR_DB_PATH=./data/simulator.db

# Agent Policy Limits
MAX_STEPS=20
ACTION_TIMEOUT_MS=15000
MAX_RETRIES=3
APPROVAL_TIMEOUT_SECONDS=300
